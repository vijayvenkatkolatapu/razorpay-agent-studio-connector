# ==========================================
# Razorpay Agent Studio - WooCommerce Connector
# Environment Configuration
# ==========================================

# Execution Mode: "mock" (default for testing/evaluation) or "live"
CONNECTOR_MODE=mock

# Live WooCommerce Store Credentials (required only when CONNECTOR_MODE=live)
WOOCOMMERCE_URL=https://your-merchant-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_test_samplekey1234567890
WOOCOMMERCE_CONSUMER_SECRET=cs_test_samplesecret1234567890

# Optional: OAuth 1.0a flow parameters (if store runs on non-SSL HTTP)
WOOCOMMERCE_AUTH_METHOD=basic_auth # "basic_auth" or "oauth1"

# Rate Limiter & Resilience Configuration
RATE_LIMIT_MAX_REQUESTS_PER_MIN=60
RATE_LIMIT_MAX_RETRIES=4
RATE_LIMIT_BASE_BACKOFF_MS=500
RATE_LIMIT_MAX_BACKOFF_MS=8000

# Logging Level: "info", "debug", "error"
LOG_LEVEL=info
